generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH & USERS ----------
model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  phone               String?
  passwordHash        String
  status              String    @default("active") // active, suspended, pending
  emailVerified       Boolean   @default(false) @map("email_verified")
  verificationToken   String?   @map("verification_token")
  verificationExpires DateTime? @map("verification_expires")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenantUsers     TenantUser[]
  staff           Staff[]
  auditLogs       AuditLog[]
  aiConversations AiConversation[]
  aiMessages      AiMessage[]
  notifications   Notification[]
  documents       Document[]
  measurements    Measurement[]
}

// ---------- TENANTS ----------
model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  businessType String   @default("other") // tailoring, clinic, laboratory, salon, auto_workshop, home_service, other
  logoUrl      String?
  phone        String?
  email        String?
  address      String?
  city         String?
  country      String?
  currency     String   @default("PKR")
  timezone     String   @default("Asia/Karachi")
  status       String   @default("active") // active, suspended, trial
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenantUsers          TenantUser[]
  roles                Role[]
  customers            Customer[]
  services             Service[]
  staff                Staff[]
  bookings             Booking[]
  orders               Order[]
  invoices             Invoice[]
  payments             Payment[]
  notifications        Notification[]
  documents            Document[]
  subscriptions        Subscription[]
  auditLogs            AuditLog[]
  measurementFields    MeasurementField[]
  measurements         Measurement[]
  garments             Garment[]
  tailoringOrders      TailoringOrder[]
  garmentDesigns       GarmentDesign[]
  aiConversations      AiConversation[]
  serviceCategories    ServiceCategory[]
  orderItems           OrderItem[]
  orderStatusHistories OrderStatusHistory[]
}

// ---------- TENANT USERS (MEMBERSHIPS) ----------
model TenantUser {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String?  @map("role_id")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

// ---------- ROLES ----------
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantUsers     TenantUser[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ---------- CUSTOMERS ----------
model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  accountId String?  @map("account_id")
  name      String
  phone     String
  email     String?
  address   String?
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  orders          Order[]
  invoices        Invoice[]
  payments        Payment[]
  measurements    Measurement[]
  garments        Garment[]
  tailoringOrders TailoringOrder[]
  documents       Document[]

  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("customers")
}

// ---------- SERVICE CATEGORIES ----------
model ServiceCategory {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@map("service_categories")
}

// ---------- SERVICES ----------
model Service {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  categoryId       String?  @map("category_id")
  name             String
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  duration         Int? // minutes
  status           String   @default("active")
  requiresBooking  Boolean  @default(false) @map("requires_booking")
  requiresDelivery Boolean  @default(false) @map("requires_delivery")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  measurementTemplate MeasurementTemplate? @relation(fields: [measurementTemplateId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  bookings   Booking[]

  @@map("services")
}

// ---------- STAFF ----------
model Staff {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  jobTitle   String
  department String?
  skills     String?
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability StaffAvailability[]
  bookings     Booking[]
  orderItems   OrderItem[]
  staffOrders  TailoringOrder[] // customization: linking staff to tailoring orders
}

model StaffAvailability {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  staffId   String @map("staff_id")
  dayOfWeek Int    @map("day_of_week") // 0=Sun ... 6=Sat
  startTime String @map("start_time") // HH:MM
  endTime   String @map("end_time")

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_availability")
}

// ---------- BOOKINGS ----------
model Booking {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  customerId  String   @map("customer_id")
  serviceId   String   @map("service_id")
  staffId     String?  @map("staff_id")
  bookingDate DateTime @map("booking_date")
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  status      String   @default("pending")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([tenantId, startTime, status])
  @@map("bookings")
}

// ---------- ORDERS ----------
model Order {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  customerId    String    @map("customer_id")
  orderNumber   String    @unique @map("order_number")
  priority      String    @default("normal")
  expectedDate  DateTime? @map("expected_date")
  completedDate DateTime? @map("completed_date")
  status        String    @default("received") // received, measurement, cutting, stitching, finishing, quality_check, ready, delivered, cancelled (tailoring) / tested, verified, reported, etc.
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  invoices       Invoice[]
  payments       Payment[]
  tailoringOrder TailoringOrder?
  garments       Garment[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  orderId   String  @map("order_id")
  serviceId String  @map("service_id")
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id])
  staffId String?

  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  orderId   String   @map("order_id")
  status    String
  changedBy String?  @map("changed_by")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// ---------- INVOICES ----------
model Invoice {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  customerId    String    @map("customer_id")
  orderId       String?   @map("order_id")
  invoiceNumber String    @unique @map("invoice_number")
  subtotal      Decimal   @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  tax           Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @db.Decimal(12, 2)
  paidAmount    Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balance       Decimal   @db.Decimal(12, 2)
  status        String    @default("draft") // draft, issued, partially_paid, paid, cancelled
  issuedAt      DateTime? @map("issued_at")
  dueAt         DateTime? @map("due_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([tenantId, status])
  @@map("invoices")
}

// ---------- PAYMENTS ----------
model Payment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  invoiceId  String   @map("invoice_id")
  customerId String   @map("customer_id")
  amount     Decimal  @db.Decimal(12, 2)
  method     String // cash, bank_transfer, mobile_wallet, card, online
  reference  String?
  status     String   @default("completed") // pending, completed, failed, refunded
  paidAt     DateTime @default(now()) @map("paid_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id])
  orderId  String?

  @@index([tenantId, paidAt])
  @@map("payments")
}

// ---------- NOTIFICATIONS ----------
model Notification {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String?   @map("user_id")
  type      String
  title     String
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("notifications")
}

// ---------- DOCUMENTS ----------
model Document {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  uploadedBy String   @map("uploaded_by")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  fileSize   Int      @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@map("documents")
}

// ---------- SUBSCRIPTIONS ----------
model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice  Decimal  @map("yearly_price") @db.Decimal(12, 2)
  maxStaff     Int      @map("max_staff")
  maxCustomers Int      @map("max_customers")
  maxOrders    Int      @map("max_orders")
  features     String? // JSON string for simplicity
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  planId    String    @map("plan_id")
  status    String    @default("trial") // trial, active, past_due, cancelled, suspended
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------- AI ----------
model AiConversation {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  role           String // user, assistant
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id])
  userId       String?

  @@map("ai_messages")
}

// ---------- AUDIT LOGS ----------
model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  metadata  String? // JSON
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

// ---------- TAILORING MODULE ----------

// Custom measurement fields per tenant (e.g., Height, Chest, Waist)
model MeasurementField {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String // machine name
  label     String // display label
  type      String   @default("number") // number, text, select
  isCustom  Boolean  @default(true) @map("is_custom")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  measurements Measurement[]

  @@map("measurement_fields")
}

model Measurement {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String?  @map("customer_id")
  garmentId  String?  @map("garment_id")
  createdBy  String   @map("created_by")
  fields     Json // JSON key-value of measurements
  templateId  String? @map("template_id")
  unit        String   @default("inch") @map("unit")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  garment            Garment?          @relation(fields: [garmentId], references: [id], onDelete: SetNull)
  tailoringOrders    TailoringOrder[]
  creator            User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  measurementField   MeasurementField? @relation(fields: [measurementFieldId], references: [id])
  measurementFieldId String?

  @@map("measurements")
}

model Garment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  customerId   String   @map("customer_id")
  name         String
  category     String? // Shalwar Kameez, Suit, Kurta, Waistcoat
  description  String?
  designRefUrl String?  @map("design_ref_url")
  status       String   @default("pending") // pending, measured, cutting, stitching, finishing, quality_check, ready, delivered
  measurementTemplateId String? @map("measurement_template_id")
  orderId      String?  @map("order_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  measurements    Measurement[]
  designs         GarmentDesign[]
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  tailoringOrders TailoringOrder[]

  @@index([tenantId, status])
  @@map("garments")
}

model GarmentDesign {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  garmentId   String   @map("garment_id")
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@map("garment_designs")
}

model TailoringOrder {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  orderId      String    @map("order_id")
  customerId   String    @map("customer_id")
  garmentId    String?   @map("garment_id")
  measurementId String? @map("measurement_id")
  measurement  Measurement? @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  staffId      String?   @map("staff_id")
  status       String    @default("received") // received, measurement, cutting, stitching, finishing, quality_check, ready, delivered, cancelled
  deliveryDate DateTime? @map("delivery_date")
  priority     String    @default("normal")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  garment  Garment? @relation(fields: [garmentId], references: [id], onDelete: SetNull)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([orderId])
  @@index([tenantId, status])
  @@map("tailoring_orders")
}

model MeasurementTemplate {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  code         String
  category     String?
  defaultUnit  String   @default("inch") @map("default_unit")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields     MeasurementTemplateField[]
  services   Service[]
  garments   Garment[]
  measurements Measurement[]

  @@map("measurement_templates")
  @@unique([tenantId, code])
}

model MeasurementTemplateField {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  name       String
  label      String
  section    String?
  type       String   @default("number")
  unit       String?
  required   Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")

  template  MeasurementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("measurement_template_fields")
  @@unique([templateId, name])
}
